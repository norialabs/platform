{
  "name": "norialabs/platform",
  "description": "The chassis every Noria Laravel product sits on: workspace tenancy with row level security, RBAC, an audit trail, passwordless auth, database operations, and the shared primitives. Internal.",
  "license": "MIT",
  "type": "library",
  "authors": [
    {
      "name": "Joseph Gitonga",
      "email": "thekiharani@gmail.com",
      "homepage": "https://github.com/thekiharani"
    }
  ],
  "require": {
    "php": "^8.5",
    "illuminate/auth": "^13.0",
    "illuminate/bus": "^13.0",
    "illuminate/console": "^13.0",
    "illuminate/database": "^13.0",
    "illuminate/http": "^13.0",
    "illuminate/queue": "^13.0",
    "illuminate/support": "^13.0"
  },
  "require-dev": {
    "larastan/larastan": "^3.0",
    "laravel/pint": "^1.20",
    "orchestra/testbench": "^11.0",
    "pestphp/pest": "^5.0",
    "laravel/sanctum": "^4.0"
  },
  "autoload": {
    "psr-4": {
      "NoriaLabs\\Platform\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "NoriaLabs\\Platform\\Tests\\": "tests/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "NoriaLabs\\Platform\\PlatformServiceProvider"
      ]
    }
  },
  "config": {
    "allow-plugins": {
      "pestphp/pest-plugin": true
    },
    "sort-packages": true
  },
  "minimum-stability": "stable",
  "prefer-stable": true,
  "suggest": {
    "laravel/sanctum": "Required only for PersonalAccessToken, the workspace-scoped token model."
  }
}
